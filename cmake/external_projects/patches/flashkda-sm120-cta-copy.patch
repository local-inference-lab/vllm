 #include "cutlass/arch/reg_reconfig.h"
 
+__device__ __forceinline__ void copy_cta_workspace(
+    void const* source, uint64_t* barrier, void* destination, int32_t bytes
+) {
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 1200
+    // Both shared addresses belong to this CTA. The cluster-addressed bulk
+    // copy uses a device syscall on SM120 and reserves a large context stack.
+    uint32_t dst = cute::cast_smem_ptr_to_uint(destination);
+    uint32_t mbar = cute::cast_smem_ptr_to_uint(barrier);
+    asm volatile(
+        "cp.async.bulk.shared::cta.global.mbarrier::complete_tx::bytes "
+        "[%0], [%1], %2, [%3];\n"
+        :
+        : "r"(dst), "l"(source), "r"(bytes), "r"(mbar)
+        : "memory");
+#else
+    cute::SM90_BULK_COPY_G2S::copy(source, barrier, destination, bytes);
+#endif
+}
+
